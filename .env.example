# PrepWise frontend environment.
# Copy to .env.local for local development:  copy .env.example .env.local
#
# Every VITE_* variable is embedded in the public JavaScript bundle.
# NEVER put secrets here (Django secret key, AI provider keys, payment secrets).

# Base URL of the backend API, including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Display name used in the UI.
VITE_APP_NAME=PrepWise

# Payments need no frontend configuration: the backend sends the gateway's public
# key ID with each order. Gateway secrets belong in backend/.env only.
