# =====================================================================
# PrepWise Frontend (React / Vite) - .gitignore
# =====================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/

# Local environment and secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
!.env.example

# Vite cache & temp files
.vite/
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/

# Linter & Formatter caches
.eslintcache
.stylelintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and IDE directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
